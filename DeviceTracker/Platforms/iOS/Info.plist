<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>LSRequiresIPhoneOS</key>
    <true/>
    <key>UIDeviceFamily</key>
    <array>
        <integer>1</integer>
        <integer>2</integer>
    </array>
    <key>UIRequiredDeviceCapabilities</key>
    <array>
        <string>arm64</string>
        <string>location-services</string>
    </array>
    <key>UIBackgroundModes</key>
    <array>
        <string>location</string>
        <string>fetch</string>
        <string>processing</string>
    </array>
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>DeviceTracker needs location access to track device location for asset management.</string>
    <key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
    <string>DeviceTracker needs background location access to continuously track device location.</string>
    <key>BGTaskSchedulerPermittedIdentifiers</key>
    <array>
        <string>com.enterprise.devicetracker.location</string>
        <string>com.enterprise.devicetracker.cleanup</string>
    </array>
    <key>MinimumOSVersion</key>
    <string>15.0</string>
</dict>
</plist>
